rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quizzes/{quizId} {

      // クイズ設定・フェーズ管理ドキュメント
      // 認証済みユーザー（匿名含む）のみ読み書き可
      match /state/current {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // 投票データ
      match /votes/{voteId} {
        // 読み取り: 認証済みユーザーのみ（重複チェック・集計に使用）
        allow read: if request.auth != null;

        // 作成: 認証済みユーザーのみ・フィールドバリデーション付き
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['name', 'group', 'answer', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.group in ['groom', 'bride']
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0;

        // 更新・削除は禁止（投票の改ざん防止）
        allow update, delete: if false;
      }
    }
  }
}
